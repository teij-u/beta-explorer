---
import Layout from '../layouts/Layout.astro';
---

<Layout title="スポットを投稿 | β-Explorer">

  <div class="max-w-2xl mx-auto py-8">

    <a href="/" class="back-link mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      スポット一覧に戻る
    </a>

    {/* フォームカード */}
    <div id="form-container" class="bg-white dark:bg-zinc-800 rounded-xl border border-gray-100 dark:border-zinc-700 p-6 md:p-8 mt-4">

      <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-zinc-100 tracking-tight">スポットを投稿</h1>
      <p class="text-sm text-gray-500 dark:text-zinc-400 mt-1 mb-6">あなたのおすすめ穴場スポットを共有しましょう</p>

      <form
        id="submit-form"
        name="spot-submission"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="spot-submission" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        {/* スポット名 */}
        <div>
          <label for="spot-name" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">
            スポット名 <span class="text-red-400">*</span>
          </label>
          <input type="text" id="spot-name" name="spot-name" required class="input-field" placeholder="例：秘密の展望台" />
        </div>

        {/* 地域・カテゴリー */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="region" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">地域</label>
            <select id="region" name="region" class="input-field">
              <option value="">選択してください</option>
              <option value="東京">東京</option>
              <option value="大阪">大阪</option>
              <option value="京都">京都</option>
              <option value="北海道">北海道</option>
              <option value="沖縄">沖縄</option>
              <option value="九州">九州</option>
              <option value="四国">四国</option>
              <option value="中国地方">中国地方</option>
              <option value="中部">中部</option>
              <option value="東北">東北</option>
              <option value="関東(その他)">関東(その他)</option>
              <option value="その他">その他</option>
            </select>
          </div>
          <div>
            <label for="category" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">カテゴリー</label>
            <select id="category" name="category" class="input-field">
              <option value="">選択してください</option>
              <option value="カフェ">カフェ</option>
              <option value="自然">自然</option>
              <option value="寺社仏閣">寺社仏閣</option>
              <option value="温泉">温泉</option>
              <option value="グルメ">グルメ</option>
              <option value="アクティビティ">アクティビティ</option>
              <option value="絶景">絶景</option>
              <option value="歴史">歴史</option>
              <option value="ショッピング">ショッピング</option>
              <option value="その他">その他</option>
            </select>
          </div>
        </div>

        {/* 住所 */}
        <div>
          <label for="address" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">住所</label>
          <input type="text" id="address" name="address" class="input-field" placeholder="例：東京都渋谷区..." />
        </div>

        {/* 説明 */}
        <div>
          <label for="description" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">
            説明 <span class="text-red-400">*</span>
          </label>
          <textarea id="description" name="description" required rows="4" class="input-field resize-y" placeholder="このスポットの魅力を教えてください"></textarea>
        </div>

        {/* おすすめポイント */}
        <div>
          <label for="recommendation" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">おすすめポイント</label>
          <textarea id="recommendation" name="recommendation" rows="3" class="input-field resize-y" placeholder="他の旅行者へのアドバイスなど"></textarea>
        </div>

        {/* ニックネーム */}
        <div>
          <label for="nickname" class="block mb-1.5 text-xs font-medium text-gray-500 dark:text-zinc-400">ニックネーム</label>
          <input type="text" id="nickname" name="nickname" class="input-field" placeholder="例：旅好き太郎" />
        </div>

        {/* 送信 */}
        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-lg hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors"
          >
            投稿する
          </button>
        </div>

      </form>
    </div>

    {/* 成功メッセージ */}
    <div id="success-message" class="hidden bg-white dark:bg-zinc-800 rounded-xl border border-gray-100 dark:border-zinc-700 p-8 md:p-12 text-center mt-4">
      <div class="flex items-center justify-center w-12 h-12 mx-auto mb-5 rounded-full bg-emerald-50 dark:bg-emerald-900/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900 dark:text-zinc-100">投稿ありがとうございます</h2>
      <p class="text-sm text-gray-500 dark:text-zinc-400 mt-2 mb-6">いただいた情報を確認のうえ、サイトに掲載いたします。</p>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        スポット一覧に戻る
      </a>
    </div>

  </div>

  <script is:inline>
    const form = document.getElementById('submit-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '送信中...';
        submitBtn.classList.add('opacity-60');
      }
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });
        document.getElementById('form-container')?.classList.add('hidden');
        document.getElementById('success-message')?.classList.remove('hidden');
      } catch (error) {
        alert('送信に失敗しました。もう一度お試しください。');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '投稿する';
          submitBtn.classList.remove('opacity-60');
        }
      }
    });
  </script>

</Layout>
