---
import Layout from '../layouts/Layout.astro';
---

<Layout title="スポットを投稿 - β-Explorer">

  <div class="max-w-2xl mx-auto py-8 md:py-12">

    <!-- 戻るリンク -->
    <a href="/" class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      スポット一覧に戻る
    </a>

    <!-- フォームカード -->
    <div id="form-container" class="bg-white dark:bg-zinc-800 rounded-2xl shadow-xl p-6 md:p-10 border border-gray-200 dark:border-zinc-700">

      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-zinc-100 mb-2">スポットを投稿</h1>
      <p class="text-gray-500 dark:text-zinc-400 mb-8">あなたのおすすめ穴場スポットを共有しましょう！</p>

      <form
        id="submit-form"
        name="spot-submission"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="spot-submission" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <!-- スポット名 -->
        <div>
          <label for="spot-name" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
            スポット名 <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="spot-name"
            name="spot-name"
            required
            class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors"
            placeholder="例：秘密の展望台"
          />
        </div>

        <!-- 地域・カテゴリー 横並び -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- 地域 -->
          <div>
            <label for="region" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
              地域
            </label>
            <select
              id="region"
              name="region"
              class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors"
            >
              <option value="">選択してください</option>
              <option value="東京">東京</option>
              <option value="大阪">大阪</option>
              <option value="京都">京都</option>
              <option value="北海道">北海道</option>
              <option value="沖縄">沖縄</option>
              <option value="九州">九州</option>
              <option value="四国">四国</option>
              <option value="中国地方">中国地方</option>
              <option value="中部">中部</option>
              <option value="東北">東北</option>
              <option value="関東(その他)">関東(その他)</option>
              <option value="その他">その他</option>
            </select>
          </div>

          <!-- カテゴリー -->
          <div>
            <label for="category" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
              カテゴリー
            </label>
            <select
              id="category"
              name="category"
              class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors"
            >
              <option value="">選択してください</option>
              <option value="カフェ">カフェ</option>
              <option value="自然">自然</option>
              <option value="寺社仏閣">寺社仏閣</option>
              <option value="温泉">温泉</option>
              <option value="グルメ">グルメ</option>
              <option value="アクティビティ">アクティビティ</option>
              <option value="絶景">絶景</option>
              <option value="歴史">歴史</option>
              <option value="ショッピング">ショッピング</option>
              <option value="その他">その他</option>
            </select>
          </div>
        </div>

        <!-- 住所 -->
        <div>
          <label for="address" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
            住所
          </label>
          <input
            type="text"
            id="address"
            name="address"
            class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors"
            placeholder="例：東京都渋谷区..."
          />
        </div>

        <!-- 説明 -->
        <div>
          <label for="description" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
            説明 <span class="text-red-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            required
            rows="4"
            class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors resize-y"
            placeholder="このスポットの魅力を教えてください"
          ></textarea>
        </div>

        <!-- おすすめポイント -->
        <div>
          <label for="recommendation" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
            おすすめポイント
          </label>
          <textarea
            id="recommendation"
            name="recommendation"
            rows="3"
            class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors resize-y"
            placeholder="他の旅行者へのアドバイスなど"
          ></textarea>
        </div>

        <!-- ニックネーム -->
        <div>
          <label for="nickname" class="block mb-1.5 text-sm font-semibold text-gray-700 dark:text-zinc-300">
            ニックネーム
          </label>
          <input
            type="text"
            id="nickname"
            name="nickname"
            class="w-full p-3 border-2 border-gray-200 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 dark:text-white focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-colors"
            placeholder="例：旅好き太郎"
          />
        </div>

        <!-- 送信ボタン -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 active:bg-blue-800 transition-colors shadow-md"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            投稿する
          </button>
        </div>

      </form>
    </div>

    <!-- 送信成功メッセージ -->
    <div id="success-message" class="hidden bg-white dark:bg-zinc-800 rounded-2xl shadow-xl p-8 md:p-12 border border-gray-200 dark:border-zinc-700 text-center">
      <div class="flex items-center justify-center w-16 h-16 mx-auto mb-6 rounded-full bg-green-100 dark:bg-green-900/40">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-zinc-100 mb-2">投稿ありがとうございます！</h2>
      <p class="text-gray-500 dark:text-zinc-400 mb-8">いただいた情報を確認のうえ、サイトに掲載いたします。</p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        スポット一覧に戻る
      </a>
    </div>

  </div>

  <script is:inline>
    const form = document.getElementById('submit-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '送信中...';
      }
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });
        document.getElementById('form-container')?.classList.add('hidden');
        document.getElementById('success-message')?.classList.remove('hidden');
      } catch (error) {
        alert('送信に失敗しました。もう一度お試しください。');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '投稿する';
        }
      }
    });
  </script>

</Layout>
