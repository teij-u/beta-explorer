---
import Layout from '../../layouts/Layout.astro';
import { createClient } from 'microcms-js-sdk';
import { getCategoryClasses } from '../../utils/tagColors';

type Spot = {
  id: string;
  spotName: string;
  description: string;
  image?: {
    url: string;
    height: number;
    width: number;
  };
  category: string[];
  region: string[];
  address?: string;
  affiliateLink?: string;
};

const { id } = Astro.params;

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});
const spot: Spot = await client.get({
  endpoint: "spots",
  contentId: String(id),
});
---

<Layout title={spot.spotName} description={spot.description.replace(/<[^>]*>/g, '').substring(0, 160)} image={spot.image?.url}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": spot.spotName,
    "description": spot.description.replace(/<[^>]*>/g, '').substring(0, 200),
    "address": spot.address || undefined,
    "image": spot.image?.url || undefined
  })} />

  <div class="py-8">

    {/* 戻るリンク */}
    <a href="/" class="back-link mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      スポット一覧に戻る
    </a>

    {/* メインカード */}
    <div class="bg-white dark:bg-zinc-800 rounded-xl border border-gray-100 dark:border-zinc-700 overflow-hidden mt-4">

      {/* 画像（フルワイド） */}
      {spot.image ? (
        <img src={spot.image.url} alt={spot.spotName} class="w-full h-64 md:h-96 object-cover" />
      ) : (
        <div class="w-full h-64 md:h-96 bg-gray-100 dark:bg-zinc-700 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V5.25a1.5 1.5 0 00-1.5-1.5H3.75a1.5 1.5 0 00-1.5 1.5v14.25a1.5 1.5 0 001.5 1.5z" />
          </svg>
        </div>
      )}

      {/* コンテンツ */}
      <div class="p-6 md:p-10">

        {/* バッジ */}
        <div class="flex items-center gap-2 mb-4">
          <a href={`/category/${spot.category[0]}/`}>
            <span class={`badge-category ${getCategoryClasses(spot.category[0])}`}>{spot.category[0]}</span>
          </a>
          <a href={`/region/${spot.region[0]}/`}>
            <span class="badge-region">{spot.region[0]}</span>
          </a>
        </div>

        {/* タイトル */}
        <h1 class="text-2xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100 tracking-tight">{spot.spotName}</h1>

        {/* 2カラム */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">

          {/* 左: 説明文 */}
          <div class="md:col-span-2">
            <div class="prose prose-gray max-w-none dark:prose-invert text-gray-700 dark:text-zinc-300" set:html={spot.description} />
          </div>

          {/* 右: 情報 */}
          <div class="space-y-6">
            {/* 住所 */}
            <div class="bg-gray-50 dark:bg-zinc-700/50 rounded-lg p-4">
              <p class="text-xs font-medium text-gray-500 dark:text-zinc-400 mb-1">住所</p>
              <p class="text-sm text-gray-900 dark:text-zinc-100">{spot.address || '情報なし'}</p>
            </div>

            {/* アフィリエイト */}
            {spot.affiliateLink && (
              <a
                href={spot.affiliateLink}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center py-3 px-6 bg-orange-500 text-white text-sm font-medium rounded-lg hover:bg-orange-600 transition-colors shadow-sm"
              >
                Klookで予約・詳細を見る
              </a>
            )}
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>
