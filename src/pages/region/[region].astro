---
import Layout from '../../layouts/Layout.astro';
import { createClient } from 'microcms-js-sdk';
import { getCategoryClasses } from '../../utils/tagColors';

type Spot = {
  id: string;
  spotName: string;
  description: string;
  image?: { url: string; height: number; width: number; };
  category: string[];
  region: string[];
};

const { region } = Astro.params;

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

const response = await client.get({
  endpoint: "spots",
  queries: { filters: `region[contains]${region}` }
});
const spots: Spot[] = response.contents;
---

<Layout title={`地域: ${region} | β-Explorer`} description={`${region}エリアの穴場スポット一覧。β-Explorerで${region}のまだ知られていないNTAAスポットを探そう。`}>

  <div class="py-8">

    <a href="/" class="back-link mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      スポット一覧に戻る
    </a>

    <div class="flex items-center gap-3 mt-4 mb-6">
      <span class="badge-region text-sm px-3 py-1">{region}</span>
      <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-zinc-100 tracking-tight">の穴場スポット</h1>
      <span class="text-xs text-gray-400 dark:text-zinc-500">{spots.length}件</span>
    </div>

    <ul class="grid gap-4 md:gap-5 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {spots.map((spot) => (
        <li
          class="spot-card bg-white dark:bg-zinc-800 rounded-xl overflow-hidden flex flex-col border border-gray-100 dark:border-zinc-700/50"
        >
          <div class="relative">
            <a href={`/spots/${spot.id}/`}>
              {spot.image ? (
                <img src={spot.image.url} alt={spot.spotName} class="w-full h-32 sm:h-44 object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-32 sm:h-44 bg-gray-100 dark:bg-zinc-700 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-300 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V5.25a1.5 1.5 0 00-1.5-1.5H3.75a1.5 1.5 0 00-1.5 1.5v14.25a1.5 1.5 0 001.5 1.5z" />
                  </svg>
                </div>
              )}
            </a>
          </div>
          <div class="p-3 sm:p-4 flex-grow flex flex-col relative group">
            <div class="flex items-center flex-wrap gap-1.5 mb-2">
              <a href={`/category/${spot.category[0]}/`} class="relative z-10">
                <span class={`badge-category ${getCategoryClasses(spot.category[0])}`}>{spot.category[0]}</span>
              </a>
              <a href={`/region/${spot.region[0]}/`} class="relative z-10">
                <span class="badge-region">{spot.region[0]}</span>
              </a>
            </div>
            <h2 class="text-sm md:text-base font-semibold text-gray-900 dark:text-zinc-100 leading-snug line-clamp-2">
              {spot.spotName}
            </h2>
            <div class="prose prose-xs mt-1.5 text-gray-400 dark:text-zinc-500 dark:prose-invert line-clamp-2 text-[11px] sm:text-xs leading-relaxed" set:html={spot.description} />
            <a href={`/spots/${spot.id}/`} class="absolute inset-0 z-0" aria-label={spot.spotName}></a>
          </div>
        </li>
      ))}
    </ul>

  </div>
</Layout>
