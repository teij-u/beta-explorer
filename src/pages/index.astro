---
import Layout from '../layouts/Layout.astro';
import { createClient } from 'microcms-js-sdk';
import { getCategoryClasses } from '../utils/tagColors';

type Spot = {
  id: string;
  spotName: string;
  description: string;
  image?: { url: string; height: number; width: number; };
  category: string[];
  region: string[];
};

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

const response = await client.get<{ contents: Spot[] }>({
  endpoint: "spots",
  queries: { limit: 100 }
});
const spots: Spot[] = response.contents;

const allCategories = spots.flatMap((spot) => spot.category);
const uniqueCategories = [...new Set(allCategories)];

const allRegions = spots.flatMap((spot) => spot.region);
const uniqueRegions = [...new Set(allRegions)];
---

<Layout title="β-Explorer - 穴場スポット探索">

  {/* ===== ヒーロー ===== */}
  <div
    class="relative h-52 md:h-64 overflow-hidden bg-cover bg-center flex items-center justify-center text-center rounded-2xl mt-6 hidden sm:flex"
    style={`background-image: url('/images/hero-image.jpg');`}
  >
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/50 rounded-2xl"></div>
    <div class="relative z-10 px-4">
      <h1 class="text-3xl md:text-5xl font-bold text-shadow-lg text-white tracking-tight">β-Explorer</h1>
      <p class="text-sm md:text-base text-white/80 mt-3 font-light tracking-wide">
        まだ誰も知らない穴場スポットを、発見しよう
      </p>
    </div>
  </div>

  {/* ===== 検索パネル ===== */}
  <div class="bg-white dark:bg-zinc-800 rounded-xl p-4 md:p-5 shadow-sm max-w-4xl mx-auto relative z-30 mt-6 border border-gray-100 dark:border-zinc-700">

    {/* PC */}
    <div class="hidden md:flex items-end gap-3">
      <div class="flex-grow">
        <label for="keyword" class="block mb-1 text-xs font-medium text-gray-500 dark:text-zinc-400">キーワード</label>
        <input type="text" id="keyword" class="input-field" placeholder="スポット名や特徴で検索...">
      </div>
      <div class="w-40">
        <label for="region" class="block mb-1 text-xs font-medium text-gray-500 dark:text-zinc-400">地域</label>
        <select id="region" class="input-field">
          <option value="">すべて</option>
          {uniqueRegions.map(region => <option value={region}>{region}</option>)}
        </select>
      </div>
      <div class="w-40">
        <label for="category" class="block mb-1 text-xs font-medium text-gray-500 dark:text-zinc-400">カテゴリー</label>
        <select id="category" class="input-field">
          <option value="">すべて</option>
          {uniqueCategories.map(category => <option value={category}>{category}</option>)}
        </select>
      </div>
      <div>
        <button id="search-btn" class="flex items-center justify-center gap-2 px-5 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-lg hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          検索
        </button>
      </div>
    </div>

    {/* SP */}
    <div class="md:hidden">
      <div class="relative flex items-center gap-2">
        <input type="text" id="keyword-mobile" class="input-field pr-20" placeholder="スポットを検索...">
        <div class="absolute right-1 flex items-center gap-1">
          <button id="filter-toggle-btn" class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
          </button>
          <button id="search-btn-mobile" class="p-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-md transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </button>
        </div>
      </div>
      <div id="mobile-filters" class="hidden mt-3 space-y-3">
        <div>
          <label for="region-mobile" class="block mb-1 text-xs font-medium text-gray-500 dark:text-zinc-400">地域</label>
          <select id="region-mobile" class="input-field">
            <option value="">すべて</option>
            {uniqueRegions.map(region => <option value={region}>{region}</option>)}
          </select>
        </div>
        <div>
          <label for="category-mobile" class="block mb-1 text-xs font-medium text-gray-500 dark:text-zinc-400">カテゴリー</label>
          <select id="category-mobile" class="input-field">
            <option value="">すべて</option>
            {uniqueCategories.map(category => <option value={category}>{category}</option>)}
          </select>
        </div>
      </div>
    </div>

    <div class="flex justify-end mt-3">
      <button id="clear-btn" class="text-xs text-gray-400 dark:text-zinc-500 hover:text-gray-600 dark:hover:text-zinc-300 transition-colors">条件をクリア</button>
    </div>
  </div>

  {/* ===== 新規スポットFAB ===== */}
  <a
    href="/submit/"
    id="submitFab"
    class="fixed bottom-6 right-6 md:bottom-8 md:right-10 z-50 inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    スポットを投稿
  </a>

  {/* ===== スポット件数 ===== */}
  <div class="flex justify-between items-center mt-8 mb-4">
    <p id="spot-count" class="text-xs text-gray-400 dark:text-zinc-500">
      <span class="font-medium text-gray-600 dark:text-zinc-300">{spots.length}</span> 件のスポット
    </p>
  </div>

  {/* ===== スポット一覧 ===== */}
  <ul id="spotList" class="grid grid-cols-2 gap-4 md:gap-5 md:grid-cols-3 lg:grid-cols-4">
    {spots.map((spot) => (
      <li
        class="spot-card bg-white dark:bg-zinc-800 rounded-xl overflow-hidden flex flex-col border border-gray-100 dark:border-zinc-700/50"
        data-spot-name={spot.spotName}
        data-description={spot.description}
        data-region={spot.region[0]}
        data-category={spot.category.join(',')}
      >
        <div class="relative">
          <a href={`/spots/${spot.id}/`}>
            {spot.image ? (
              <img src={spot.image.url} alt={spot.spotName} class="w-full h-32 sm:h-44 object-cover" loading="lazy" />
            ) : (
              <div class="w-full h-32 sm:h-44 bg-gray-100 dark:bg-zinc-700 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-300 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V5.25a1.5 1.5 0 00-1.5-1.5H3.75a1.5 1.5 0 00-1.5 1.5v14.25a1.5 1.5 0 001.5 1.5z" />
                </svg>
              </div>
            )}
          </a>
        </div>
        <div class="p-3 sm:p-4 flex-grow flex flex-col relative group">
          <div class="flex items-center flex-wrap gap-1.5 mb-2">
            <a href={`/category/${spot.category[0]}/`} class="relative z-10">
              <span class={`badge-category ${getCategoryClasses(spot.category[0])}`}>
                {spot.category[0]}
              </span>
            </a>
            <a href={`/region/${spot.region[0]}/`} class="relative z-10">
              <span class="badge-region">
                {spot.region[0]}
              </span>
            </a>
          </div>
          <h2 class="text-sm md:text-base font-semibold text-gray-900 dark:text-zinc-100 leading-snug line-clamp-2">
            {spot.spotName}
          </h2>
          <div
            class="prose prose-xs mt-1.5 text-gray-400 dark:text-zinc-500 dark:prose-invert line-clamp-2 text-[11px] sm:text-xs leading-relaxed"
            set:html={spot.description}
          />
          <a href={`/spots/${spot.id}/`} class="absolute inset-0 z-0" aria-label={spot.spotName}></a>
        </div>
      </li>
    ))}
  </ul>

  {/* ===== 検索結果なし ===== */}
  <div id="no-results" class="hidden text-center py-16">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-200 dark:text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <p class="mt-4 text-sm text-gray-400 dark:text-zinc-500">条件に一致するスポットが見つかりませんでした</p>
    <button id="clear-filters-btn" class="mt-3 text-sm text-blue-600 dark:text-blue-400 hover:underline">条件をクリアして全件表示</button>
  </div>

  {/* ===== トップに戻る ===== */}
  <button
    id="backToTopBtn"
    class="fixed bottom-6 right-6 md:bottom-8 md:right-10 z-50 hidden inline-flex items-center justify-center px-4 py-2 rounded-full bg-white dark:bg-zinc-800 text-gray-700 dark:text-zinc-300 text-sm border border-gray-200 dark:border-zinc-600 shadow-md hover:shadow-lg transition-all"
    title="トップに戻る"
    aria-label="ページトップへ戻る"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
    </svg>
    トップへ
  </button>

  <script is:inline>
  const keywordInput = document.getElementById('keyword');
  const regionSelect = document.getElementById('region');
  const categorySelect = document.getElementById('category');
  const searchBtn = document.getElementById('search-btn');

  const keywordInputMobile = document.getElementById('keyword-mobile');
  const regionSelectMobile = document.getElementById('region-mobile');
  const categorySelectMobile = document.getElementById('category-mobile');
  const searchBtnMobile = document.getElementById('search-btn-mobile');

  const clearBtn = document.getElementById('clear-btn');
  const spotList = document.getElementById('spotList');

  const filterToggleBtn = document.getElementById('filter-toggle-btn');
  const mobileFilters = document.getElementById('mobile-filters');

  if (spotList && clearBtn) {
    const spots = spotList.querySelectorAll('li');

    const filterSpots = () => {
      const isMobile = window.innerWidth < 768;
      const keywordTerm = (isMobile ? keywordInputMobile.value : keywordInput.value).toLowerCase();
      const regionTerm = isMobile ? regionSelectMobile.value : regionSelect.value;
      const categoryTerm = isMobile ? categorySelectMobile.value : categorySelect.value;

      spots.forEach(spot => {
        const spotData = spot.dataset;
        const region = spotData.region || '';
        const category = spotData.category || '';
        const searchText = `${spotData.spotName || ''} ${spotData.description || ''}`.toLowerCase();

        const keywordMatch = !keywordTerm || searchText.includes(keywordTerm);
        const regionMatch = !regionTerm || region === regionTerm;
        const categoryMatch = !categoryTerm || category.split(',').includes(categoryTerm);

        if (keywordMatch && regionMatch && categoryMatch) {
          spot.style.display = '';
        } else {
          spot.style.display = 'none';
        }
      });

      const visibleCount = [...spots].filter(s => s.style.display !== 'none').length;
      const noResults = document.getElementById('no-results');
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
      const countEl = document.getElementById('spot-count');
      if (countEl) {
        countEl.innerHTML = `<span class="font-medium text-gray-600 dark:text-zinc-300">${visibleCount}</span> 件のスポット`;
      }
    };

    const clearFilters = () => {
      keywordInput.value = '';
      regionSelect.value = '';
      categorySelect.value = '';
      keywordInputMobile.value = '';
      regionSelectMobile.value = '';
      categorySelectMobile.value = '';
      filterSpots();
    };

    searchBtn?.addEventListener('click', filterSpots);
    searchBtnMobile?.addEventListener('click', filterSpots);
    clearBtn.addEventListener('click', clearFilters);

    filterToggleBtn?.addEventListener('click', () => {
      mobileFilters?.classList.toggle('hidden');
    });

    document.getElementById('clear-filters-btn')?.addEventListener('click', clearFilters);

    regionSelect?.addEventListener('change', filterSpots);
    categorySelect?.addEventListener('change', filterSpots);
    regionSelectMobile?.addEventListener('change', filterSpots);
    categorySelectMobile?.addEventListener('change', filterSpots);
  }

  // FAB ↔ トップへ戻るボタンの切り替え
  const submitFab = document.getElementById('submitFab');
  const backToTopBtn = document.getElementById('backToTopBtn');
  if (submitFab && backToTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        submitFab.classList.add('hidden');
        backToTopBtn.classList.remove('hidden');
      } else {
        submitFab.classList.remove('hidden');
        backToTopBtn.classList.add('hidden');
      }
    });
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  </script>

</Layout>
