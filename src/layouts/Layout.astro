---
import ThemeToggleButton from '../components/ThemeToggleButton.astro';
const {
  title,
  description = 'β-Explorer - まだ誰も知らない穴場スポットを発見・共有するプラットフォーム。NTAA (No Tourist At All) スポットで、あなただけの旅を。',
  image = '/images/hero-image.jpg',
  ogType = 'website'
} = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="β-Explorer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="stylesheet" href="/styles/global.css">

    {import.meta.env.GOOGLE_ANALYTICS_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.GOOGLE_ANALYTICS_ID}`}></script>
        <script define:vars={{ ga_id: import.meta.env.GOOGLE_ANALYTICS_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga_id);
        </script>
      </>
    )}
  </head>
  <body class="bg-slate-50 dark:bg-zinc-900 transition-colors duration-300 min-h-screen flex flex-col">

    {/* ===== ヘッダー ===== */}
    <header class="sticky top-0 z-50 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-lg border-b border-gray-100 dark:border-zinc-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">

          {/* ロゴ */}
          <a href="/" class="flex items-center gap-2 group">
            <span class="text-xl font-bold tracking-tight text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              β-Explorer
            </span>
            <span class="hidden sm:inline-block md:hidden text-xs text-gray-400 dark:text-zinc-500 font-normal">
              穴場スポット探索
            </span>
          </a>

          {/* PC ナビ */}
          <div class="hidden md:flex items-center gap-1">
            <nav class="flex items-center gap-1 mr-3">
              <a href="/about/" class="px-3 py-1.5 text-sm text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-md transition-all">このサイトについて</a>
              <a href="/contact/" class="px-3 py-1.5 text-sm text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-md transition-all">お問い合わせ</a>
            </nav>
            <a
              href="/submit/"
              class="px-4 py-1.5 text-sm font-medium bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-md hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors"
            >
              スポットを投稿
            </a>
            <div class="ml-2">
              <ThemeToggleButton />
            </div>
          </div>

          {/* SP ハンバーガー */}
          <div class="md:hidden flex items-center gap-2">
            <ThemeToggleButton />
            <button id="menu-btn" class="p-2 text-gray-500 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white rounded-md hover:bg-gray-50 dark:hover:bg-zinc-800 transition-all" aria-label="メニューを開く">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>

        </div>

        {/* SP メニュー */}
        <div id="mobile-menu" class="md:hidden hidden border-t border-gray-100 dark:border-zinc-800">
          <nav class="py-3 space-y-1">
            <a href="/about/" class="block px-3 py-2 text-sm text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-md transition-all">このサイトについて</a>
            <a href="/contact/" class="block px-3 py-2 text-sm text-gray-600 dark:text-zinc-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-zinc-800 rounded-md transition-all">お問い合わせ</a>
            <div class="pt-2 px-3">
              <a
                href="/submit/"
                class="block w-full text-center py-2 text-sm font-medium bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-md hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors"
              >
                スポットを投稿
              </a>
            </div>
          </nav>
        </div>
      </div>
    </header>

    {/* ===== メイン ===== */}
    <div class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <main>
        <slot />
      </main>
    </div>

    {/* ===== フッター ===== */}
    <footer class="mt-20 border-t border-gray-100 dark:border-zinc-800 bg-white dark:bg-zinc-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <p class="text-sm font-semibold text-gray-900 dark:text-white">β-Explorer</p>
            <p class="text-xs text-gray-400 dark:text-zinc-500 mt-1">まだ誰も知らない穴場スポットを発見しよう</p>
          </div>
          <nav class="flex items-center gap-6 text-sm text-gray-500 dark:text-zinc-400">
            <a href="/" class="hover:text-gray-900 dark:hover:text-white transition-colors">ホーム</a>
            <a href="/about/" class="hover:text-gray-900 dark:hover:text-white transition-colors">サイトについて</a>
            <a href="/contact/" class="hover:text-gray-900 dark:hover:text-white transition-colors">お問い合わせ</a>
            <a href="/submit/" class="hover:text-gray-900 dark:hover:text-white transition-colors">投稿</a>
          </nav>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-50 dark:border-zinc-800">
          <p class="text-xs text-gray-400 dark:text-zinc-600">&copy; 2025 β-Explorer. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
